# Server Configuration
PORT=5001
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=hospital_crm_db
PGUSER=postgres
PGPASSWORD=your_password_here
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/hospital_crm_db

# Security & JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Telemetry & Logging
LOG_LEVEL=info
