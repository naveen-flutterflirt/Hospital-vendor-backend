{
  "name": "crm-backend",
  "version": "1.0.0",
  "description": "Hospital Inventory & Vendor Management CRM Backend API",
  "type": "module",
  "main": "dist/server.js",
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "clean-port": "kill -9 $(lsof -ti :5001) 2>/dev/null || true",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "keywords": [
    "hospital",
    "inventory",
    "crm",
    "express",
    "postgresql",
    "supply-chain",
    "vendor-management"
  ],
  "author": "Hospital CRM Dev Team",
  "license": "ISC",
  "dependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2"
  }
}
